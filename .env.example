# Copy to .env.local for local dev (or run: vercel env pull .env.local).
# NEVER prefix a secret with NEXT_PUBLIC_ — those are shipped to the browser.

# Supabase (Project Settings → API Keys). Server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Anthropic Claude (optional, paid). Leave empty to use Gemini for everything.
# If set, Claude writes the candidates (step 1) and option cards (step 2).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini (aistudio.google.com/apikey), free tier. Server-only.
# Used for steps 1 and 2 (unless Claude is set) and to read prices off Wikivoyage.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Vercel Cron auth. Generate with: openssl rand -hex 32
CRON_SECRET=

# Wikivoyage/MediaWiki requires a descriptive User-Agent with contact info.
WIKIVOYAGE_USER_AGENT=GroupTripDecider/1.0 (contact@example.com)

# Public base URL used in share links (the production domain, no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
